apiVersion: apps/v1
kind: Deployment
metadata:
  name: mc
  namespace: mc-namespace
  labels:
    app: mc
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mc
  template:
    metadata:
      labels:
        app: mc
    spec:
      containers:
        - name: mc-pod-1
          image: nginx:1-alpine
		  env: 
		    - name: NODE_NAME
			  valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
	    - name: mc-pod-2
		  image: busybox:1
          command: ['sh', '-c', 'while true; do echo `date` >> /var/log/shared/date.log ; sleep 1; done']
          volumeMounts:
            - name: data
              mountPath: /var/log/shared
      initContainers:
        - name: mc-pod-3
          image: busybox:1
          # Setting restartPolicy: Always makes this a sidecar container.
          restartPolicy: Always
          command: ['sh', '-c', 'tail -f /var/log/shared/date.log']
          volumeMounts:
            - name: data
              mountPath: /var/log/shared
      volumes:
        - name: data
          emptyDir: {}
