apiVersion: v1
kind: Pod
metadata:
  name: mc-pod-1
  namespace: mc-namespace
spec:
  containers:
  - name: mc-pod-1
    image: nginx:1-alpine
    env:
      - name: NODE_NAME
        valueFrom:
          fieldRef:
            fieldPath: spec.nodeName
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: myapp
  namespace: mc-namespace
  labels:
    app: myapp
spec:
  replicas: 1
  selector:
    matchLabels:
      app: myapp
  template:
    metadata:
      labels:
        app: myapp
    spec:
      containers:
        - name: mc-pod-2
          image: busybox:1
          command: ['sh', '-c', 'while true; do echo `date` >> /var/log/shared/date.txt; sleep 1; done']
          volumeMounts:
            - name: shared
              mountPath: /var/log/shared
      initContainers:
        - name: mc-pod-3
          image: busybox:1
          # Setting restartPolicy: Always makes this a sidecar container.
          restartPolicy: Always
          command: ['sh', '-c', 'tail -F /var/log/shared/date.txt']
          volumeMounts:
            - name: shared
              mountPath: /var/log/shared
      volumes:
        - name: shared
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: messaging-service
spec:
  type: ClusterIP
  selector:
    tier: msg 
  ports:
    - port: 6379
      targetPort: 6379
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hr-web-app
  labels:
    app: web-app
spec:
  replicas: 2
  selector:
    matchLabels:
      app: web-app
  template:
    metadata:
      labels:
        app: web-app
    spec:
      containers:
      - name: webapp-color
        image: kodekloud/webapp-color
